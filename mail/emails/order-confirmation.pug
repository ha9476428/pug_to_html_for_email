extends ../layouts/layout-base

block vars
  - var title = 'Xác nhận đơn hàng #' + order.id
  - var preheader = `Đơn hàng #${order.id} đã được xác nhận. Tổng: ${order.total}`

block content
  +section({ padding: ['lg', 'lg', 0] })
    span(style=`display:inline-block;padding:4px 12px;border-radius:${theme.radius.pill}px;background-color:#E6F8F3;color:${theme.color.secondary};font-family:${theme.font.family};font-size:${theme.font.size.xs}px;font-weight:${theme.font.weight.semibold};`) Đã xác nhận
    +spacer('md')
    +heading(2) Cảm ơn bạn đã đặt hàng!
    +spacer('sm')
    +text({ color: theme.color.textMuted })
      | Chúng tôi đã nhận đơn hàng
      | #[strong(style=`color:${theme.color.text};`) ##{order.id}]
      | và sẽ giao trong 2–3 ngày làm việc.

  +section
    +infoTable
      each item in order.items
        +infoRow(`${item.name} × ${item.qty}`, item.price)
      tr
        td(colspan="2")
          +divider({ spacing: 'sm' })
      +infoRow('Phí vận chuyển', order.shipping)
      +infoRow('Tổng cộng', order.total, { strong: true })

  +section({ padding: [0, 'lg', 'xl'] })
    +button('Theo dõi đơn hàng', order.trackingUrl, { bg: theme.color.secondary })
