//- Nội dung demo "Typography" — dùng chung bởi typography.pug (trang riêng) và index.pug (trang tổng hợp).
+section({ padding: ['lg', 'lg', 'sm'] })
  +heading(2) Typography
  +spacer('xs')
  +text({ color: theme.color.textMuted }) heading(level) và text({ size }) — mail/mixins/_content.pug

+section({ padding: [0, 'lg', 'md'] })
  +heading(1) Heading 1
  +spacer('xs')
  +heading(2) Heading 2
  +spacer('xs')
  +heading(3) Heading 3
  +spacer('sm')
  each px, key in theme.font.size
    +text({ size: key })
      strong size: '#{key}' (#{px}px)
      |  — Nội dung mẫu Aa Bb Cc 123
    +spacer('xs')
