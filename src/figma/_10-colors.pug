//- Nội dung demo "Colors" — dùng chung bởi colors.pug (trang riêng) và index.pug (trang tổng hợp).
+section({ padding: ['lg', 'lg', 'sm'] })
  +heading(2) Colors
  +spacer('xs')
  +text({ color: theme.color.textMuted }) theme.color — src/config/theme.js

+section({ padding: [0, 'lg', 'lg'] })
  table(role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0")
    each hex, name in theme.color
      tr
        td(style=`padding:4px 12px 4px 0;`)
          table(role="presentation" cellpadding="0" cellspacing="0" border="0")
            tr
              td(width="28" height="28" bgcolor=hex style=`width:28px;height:28px;background-color:${hex};border-radius:6px;border:1px solid ${theme.color.border};font-size:0;line-height:0;`) &nbsp;
        td(valign="middle" style=h.font({ size: 'sm' }))
          strong= name
          |  — #{hex}
