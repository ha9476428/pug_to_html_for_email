//- Xem _README.md để biết cách thêm component mới.
//-
//- Trang TỔNG HỢP DUY NHẤT — gộp toàn bộ component trong src/figma/,
//- giống trang "component library" trong Figma. Tự quét mọi file
//- _design-*.pug trong thư mục này mỗi lần build.
extends ../layouts/layout-base

block vars
  - var title = 'Component Catalog — Overview'

block content
  +section({ padding: ['xl', 'lg', 'md'] })
    +heading(1) Component Catalog
    +spacer('xs')
    +text({ color: theme.color.textMuted }) Tổng hợp toàn bộ component trong src/figma/.

  +divider
  include ./_design-buttons
  +divider
  include ./_design-colors
  +divider
  include ./_design-columns
  +divider
  include ./_design-comment-markers
  +divider
  include ./_design-footer
  +divider
  include ./_design-header
  +divider
  include ./_design-image
  +divider
  include ./_design-info-table
  +divider
  include ./_design-link
  +divider
  include ./_design-typography
