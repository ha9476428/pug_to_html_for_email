//- Trang TỔNG HỢP DUY NHẤT — gộp toàn bộ component trong src/figma/ vào 1 trang,
//- giống trang "component library" trong Figma. Include nội dung từ từng `_xxx.pug`
//- (xem _README.md) — thêm component mới thì thêm 1 `include` vào đây.
extends ../layouts/base

block vars
  - var title = 'Component Catalog — Overview'

block content
  +section({ padding: ['xl', 'lg', 'md'] })
    +heading(1) Component Catalog
    +spacer('xs')
    +text({ color: theme.color.textMuted }) Tổng hợp toàn bộ component trong src/figma/.

  +divider
  include _colors
  +divider
  include _typography
  +divider
  include _buttons
  +divider
  include _link
  +divider
  include _columns
  +divider
  include _info-table
  +divider
  include _comment-markers
  +divider
  include _image
