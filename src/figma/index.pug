//- _design-*.pug trong thư mục này mỗi lần build.
extends ../layouts/layout-base

block vars
  - var title = 'Component Catalog — Overview'

block content
  +section({ padding: ['xl', 'lg', 'md'] })
    +heading(1) Component Catalog
    +spacer('xs')
    +text({ color: theme.color.textMuted }) Tổng hợp toàn bộ component trong src/figma/.

  +divider
  include ./_design-00-header
  +divider
  include ./_design-10-colors
  +divider
  include ./_design-20-typography
  +divider
  include ./_design-30-buttons
  +divider
  include ./_design-40-link
  +divider
  include ./_design-50-columns
  +divider
  include ./_design-60-info-table
  +divider
  include ./_design-70-comment-markers
  +divider
  include ./_design-80-image
  +divider
  include ./_design-90-footer
