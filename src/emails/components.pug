//- ============================================================
//- COMPONENT CATALOG — nơi xem trước toàn bộ mixin (component) và
//- design token (màu, font, spacing) dùng chung cho mọi email.
//-
//- Đây KHÔNG phải email để gửi — chỉ phục vụ lúc phát triển, giống
//- một trang "component library" trong Figma. Chạy `npm run dev`
//- rồi mở http://localhost:3000/components.html để xem, tự reload
//- mỗi khi sửa mixin trong src/mixins/.
//-
//- Khi thêm component mới vào src/mixins/, thêm một mục demo ở đây.
//- ============================================================
extends ../layouts/base

block vars
  - var title = 'Component Catalog'

block content
  +section({ padding: ['xl', 'lg', 'md'] })
    +heading(1) Component Catalog
    +spacer('xs')
    +text({ color: theme.color.textMuted }) Toàn bộ component & token dùng trong src/mixins/ và src/config/theme.js.

  //- ---------------------------------------------------------- Colors
  +divider
  +section({ padding: ['lg', 'lg', 'sm'] })
    +heading(2) Colors — theme.color
  +section({ padding: [0, 'lg', 'lg'] })
    table(role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0")
      each hex, name in theme.color
        tr
          td(style=`padding:4px 12px 4px 0;`)
            table(role="presentation" cellpadding="0" cellspacing="0" border="0")
              tr
                td(width="28" height="28" bgcolor=hex style=`width:28px;height:28px;background-color:${hex};border-radius:6px;border:1px solid ${theme.color.border};font-size:0;line-height:0;`) &nbsp;
          td(valign="middle" style=h.font({ size: 'sm' }))
            strong= name
            |  — #{hex}

  //- -------------------------------------------------------- Typography
  +divider
  +section({ padding: ['lg', 'lg', 'sm'] })
    +heading(2) Typography — heading() / text()
  +section({ padding: [0, 'lg', 'md'] })
    +heading(1) Heading 1
    +spacer('xs')
    +heading(2) Heading 2
    +spacer('xs')
    +heading(3) Heading 3
    +spacer('sm')
    each px, key in theme.font.size
      +text({ size: key })
        strong size: '#{key}' (#{px}px)
        |  — Nội dung mẫu Aa Bb Cc 123
      +spacer('xs')

  //- ----------------------------------------------------------- Buttons
  +divider
  +section({ padding: ['lg', 'lg', 'sm'] })
    +heading(2) Buttons — button()
  +section({ padding: [0, 'lg', 'md'], align: 'left' })
    +button('Primary', '#', { align: 'left' })
    +spacer('sm')
    +button('Secondary', '#', { bg: theme.color.secondary, align: 'left' })
    +spacer('sm')
    +button('Danger', '#', { bg: theme.color.danger, align: 'left' })
    +spacer('sm')
    +button('Small', '#', { width: 140, height: 40, align: 'left' })

  //- ------------------------------------------------------------- Link
  +divider
  +section({ padding: ['lg', 'lg', 'sm'] })
    +heading(2) Link — link()
  +section({ padding: [0, 'lg', 'md'] })
    +text
      | Đoạn văn có chứa
      | #[+link('#') liên kết mẫu]
      | ở giữa nội dung.

  //- --------------------------------------------------------- Columns
  +divider
  +section({ padding: ['lg', 'lg', 'sm'] })
    +heading(2) Columns — columns() / column()
  +section({ padding: [0, 'lg', 'md'] })
    +columns
      +column(276)
        +text({ weight: 'semibold' }) Cột trái
        +text({ size: 'sm', color: theme.color.textMuted }) Tự xếp chồng trên mobile, không cần media query.
      +column(276)
        +text({ weight: 'semibold' }) Cột phải
        +text({ size: 'sm', color: theme.color.textMuted }) Tổng width 2 cột nên bằng theme.width.

  //- ------------------------------------------------------- Info table
  +divider
  +section({ padding: ['lg', 'lg', 'sm'] })
    +heading(2) Info Table — infoTable() / infoRow()
  +section({ padding: [0, 'lg', 'md'] })
    +infoTable
      +infoRow('Nhãn', 'Giá trị')
      +infoRow('Phí vận chuyển', '30.000 ₫')
      +infoRow('Tổng cộng', '1.250.000 ₫', { strong: true })

  //- ------------------------------------------------------------ Image
  +divider
  +section({ padding: ['lg', 'lg', 'sm'] })
    +heading(2) Image — image()
  +section({ padding: [0, 'lg', 'xl'] })
    +image('https://placehold.co/552x160/E5E7EB/6B7280?text=image(src,+alt,+width)', 'Ảnh mẫu', 552)
