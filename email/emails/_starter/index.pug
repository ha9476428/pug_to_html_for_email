//- Thư mục bắt đầu bằng "_" sẽ KHÔNG được build.
//- Copy cả thư mục `_starter/` thành `emails/ten-email/` để tạo email mới.
//- Dữ liệu mẫu (tuỳ chọn): tạo `data.json` cạnh file này — build sẽ tự nạp.
//- Ảnh xem thử local: đặt vào `images/` cạnh file này, dùng `+image('images/ten-anh.png', ...)`.
extends /layouts/layout-base

block vars
    - var title = 'Tiêu đề email'
    - var preheader = 'Dòng xem trước trong hộp thư'

block content
    +section
        +heading(1) Tiêu đề
        +spacer('md')
        +text Nội dung email...
        +spacer('lg')
        +button('Call to action', 'https://example.com')
